<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find hardware_core)/urdf/helpers/materials.xacro" />

    <xacro:macro name="gz_camera" params="name">
        <gazebo reference="camera_${name}">
            <sensor name="camera_${name}" type="camera">
                <always_on>true</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>
                <topic>/hardware/sensors/camera_${name}/image_raw</topic>
                <ignition_frame_id>camera_${name}</ignition_frame_id>
                <camera>
                    <horizontal_fov>2.0944</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                    </image>
                    <camera_info_topic>/hardware/sensors/camera_${name}/camera_info</camera_info_topic>
                    <optical_frame_id>camera_${name}_optical</optical_frame_id>
                </camera>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>
