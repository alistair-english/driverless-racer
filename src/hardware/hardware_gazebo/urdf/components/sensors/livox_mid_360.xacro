<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find hardware_core)/urdf/helpers/materials.xacro" />

    <xacro:macro name="gz_livox_mid_360" params="name">
        <gazebo reference="livox_${name}">
            <sensor name="livox_${name}" type="gpu_lidar">
                <always_on>true</always_on>
                <update_rate>10</update_rate>
                <visualize>true</visualize>
                <topic>/hardware/sensors/livox_${name}</topic>
                <ignition_frame_id>livox_${name}</ignition_frame_id>
                <lidar>
                    <scan>
                        <horizontal>
                            <!-- Made up resolution of 1 degree (livox have weird scanning patterns) -->
                            <samples>180</samples>
                            <resolution>1</resolution>
                            <min_angle>${-pi/2}</min_angle>
                            <max_angle>${pi/2}</max_angle>
                        </horizontal>
                        <vertical>
                            <!-- Made up resolution of 1 degrees (livox have weird scanning patterns) -->
                            <samples>59</samples>
                            <resolution>1</resolution>
                            <!-- -7 degrees -->
                            <min_angle>-0.122173</min_angle> 
                            <!--  52 degrees -->
                            <max_angle>0.907571</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.1</min>
                        <max>20.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </lidar>
            </sensor>
        </gazebo>

        <gazebo reference="livox_${name}">
            <sensor name="livox_${name}_imu" type="imu">
                <always_on>1</always_on>
                <update_rate>50</update_rate>
                <topic>/hardware/sensors/livox_${name}/imu</topic>
                <ignition_frame_id>livox_${name}</ignition_frame_id>
                <imu>
                    <enable_orientation>false</enable_orientation>
                </imu>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>