<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="steering_knuckle" params="name parent xyz">
        <joint name="steering_knuckle_${name}_joint" type="continuous">
            <parent link="${parent}"/>
            <child link="steering_knuckle_${name}"/>
            <origin xyz="${xyz}" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>

        <link name="steering_knuckle_${name}">
            <!-- Link needs _some_ intertia otherwise gazebo will ignore it -->
            <xacro:inertial_sphere mass="0.001" radius="0.001">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_sphere>
        </link>
    </xacro:macro>
</robot>
